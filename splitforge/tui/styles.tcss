Screen {
    background: #070c15;
    color: #dce8f5;
}
#topbar {
    height: 3;
    background: #0e1727;
    border-bottom: solid #20344d;
    padding: 0 2;
    align-vertical: middle;
}
#brand { width: 24; color: #7af5e3; text-style: bold; }
#host-status { width: 1fr; content-align: right middle; color: #9db4cc; }
#workspace { height: 1fr; }
#sidebar {
    width: 26;
    background: #0b1321;
    border-right: solid #20344d;
    padding: 1;
}
.utility-button { width: 100%; height: 3; min-width: 0; margin-bottom: 1; color: #7af5e3; }
#menu-title { color: #657d9a; text-style: bold; height: 2; padding-left: 1; }
.nav-button {
    width: 100%; height: 3; border: none; background: transparent;
    color: #91a9c4; text-align: left; padding-left: 1; margin-bottom: 1;
}
.nav-button:hover { background: #14263c; color: #dbfff8; }
.nav-button.selected-nav { background: #153d42; color: #7af5e3; text-style: bold; border-left: thick #59e3cf; }
#shortcuts { color: #657d9a; height: auto; padding: 1; }
#mode-label { dock: bottom; height: 3; color: #a5b2ef; padding-left: 1; }
#pages { width: 1fr; height: 1fr; }
.page { padding: 1 3; overflow-y: auto; }
.eyebrow { color: #59e3cf; text-style: bold; height: 1; }
.page-title { text-style: bold; color: #f0f7ff; height: 3; padding-top: 1; }
.subtitle { color: #8ba5c3; height: auto; margin-bottom: 1; }
.section-title { color: #a7bdd6; height: 2; padding-top: 1; text-style: bold; }
#kpis { height: 6; margin: 1 0; }
.kpi { width: 1fr; height: 5; border: round #29475d; padding: 0 1; margin-right: 1; background: #0f1d2d; }
DataTable { background: #0d1725; color: #d8e5f4; border: round #243c55; min-height: 5; }
DataTable > .datatable--header { background: #15283e; color: #7af5e3; text-style: bold; }
DataTable > .datatable--cursor { background: #254a67; color: #ffffff; }
DataTable > .datatable--odd-row { background: #101d2c; }
#health-table { height: 10; }
#overview-table { height: 9; }
#router-table, #profiles-table { height: 1fr; min-height: 8; }
.toolbar { height: auto; min-height: 3; margin: 1 0; }
.toolbar Button { margin-right: 1; min-width: 10; }
.toolbar Select { width: 1fr; margin-right: 1; }
.toolbar Input { width: 1fr; }
Button { border: round #2c4863; background: #14263a; color: #dae9fa; }
Button.-primary { background: #13665e; color: #d9fff6; border: round #3adac2; }
Button.-error { background: #442333; border: round #a85572; color: #ffd4e1; }
Button.-warning { background: #473d24; border: round #bfa268; color: #ffe5a1; }
Button:hover { text-style: bold; }
.hint { color: #7c96b4; height: auto; margin-top: 1; }
.guard-banner { border: round #245a50; background: #0e2927; color: #78e2bc; padding: 1; height: 5; margin-bottom: 1; }
Label { color: #99b1cd; margin-top: 1; height: 1; }
Input, Select { margin-bottom: 1; }
Input { border: round #2b455f; background: #0c1725; }
Input:focus { border: round #59e3cf; }
#security-profile, #dns-url, #dns-ip { max-width: 100; }
#file-tree { height: 1fr; min-height: 10; border: round #243c55; }
TabbedContent { height: 1fr; }
TabPane { padding: 1 0; }
#process-table, #service-table { height: 1fr; min-height: 8; }
#live-log { height: 1fr; min-height: 8; border: round #243c55; background: #09121e; padding: 1; }
#operation-status { height: 1; background: #0e1727; color: #8ba5c3; padding: 0 2; }
Footer { background: #101c2d; color: #a1b8d2; }
ModalScreen { align: center middle; background: #030710 85%; }
.dialog { width: 82; max-width: 94%; height: auto; max-height: 94%; overflow-y: auto; border: round #59e3cf; background: #101d2e; padding: 1 3; }
.dialog-title { color: #7af5e3; text-style: bold; height: 2; }
.dialog Select { width: 100%; min-width: 0; }
.learning-dialog { width: 92; height: 34; overflow-x: hidden; }
.learning-dialog Static { width: 100%; min-width: 0; max-width: 100%; }
#guide-scroll, #core-options { width: 100%; min-width: 0; height: 1fr; min-height: 4; overflow-x: hidden; }
.guide-toolbar { height: 3; margin-bottom: 1; }
#guide-step { width: 1fr; color: #7af5e3; padding-top: 1; }
#guide-language { min-width: 12; }
.core-description { height: auto; color: #8ba5c3; padding: 0 1 1 4; }
#core-options Checkbox { width: 100%; min-width: 0; max-width: 100%; height: auto; min-height: 3; }
#core-plan { height: auto; max-height: 4; color: #7af5e3; margin-top: 1; }
#dependency-status { height: auto; max-height: 3; margin: 1 0; color: #7af5e3; }
#dependency-progress { height: 1; margin-bottom: 1; }
.learning-dialog .dialog-actions Button { min-width: 8; margin-left: 1; padding: 0 1; }
.dialog-actions { height: 3; align-horizontal: right; margin-top: 1; }
.dialog-actions Button { margin-left: 1; }
.form-row { height: auto; }
.form-row Vertical { width: 1fr; height: auto; margin-right: 1; }
.compact #sidebar { width: 22; }
.compact .page { padding: 1; }
.compact .nav-button { margin-bottom: 0; }
.compact #shortcuts { display: none; }
